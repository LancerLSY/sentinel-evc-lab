{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "判定结果",
  "type": "object",
  "required": [
    "plan_hash",
    "parent_cert_id",
    "verdict",
    "path",
    "margins",
    "first_violation_segment",
    "full_checks_used",
    "inherit_depth",
    "reason_code"
  ],
  "additionalProperties": false,
  "properties": {
    "plan_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "parent_cert_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "FULL",
        "INHERITED",
        "REJECTED"
      ]
    },
    "path": {
      "enum": [
        "full",
        "delta"
      ]
    },
    "margins": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "first_violation_segment": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "full_checks_used": {
      "type": "integer",
      "minimum": 0
    },
    "inherit_depth": {
      "type": "integer",
      "minimum": 0
    },
    "reason_code": {
      "enum": [
        "STATE_STALE",
        "CONTEXT_CHANGED",
        "LEASE_REPLAY",
        "TRACKING_TUBE",
        "CANCEL_UNCONFIRMED",
        "LEASE_EXPIRED",
        "AUTH_FAILED",
        "QUEUE_FULL",
        null
      ]
    }
  }
}
