<mujoco model="sentinel_two_link_inspection">
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <worldbody>
    <geom name="floor" type="plane" size="1 1 .05"/>
    <body name="base" pos="0 0 .05">
      <geom name="base_shell" type="cylinder" size=".09 .05" rgba=".16 .3 .36 1"/>
      <body name="shoulder" pos="0 0 .05">
        <joint name="yaw" type="hinge" axis="0 0 1" range="-90 90" damping="2"/>
        <geom name="upper_link" type="box" size=".035 .035 .175" pos="0 0 .175" rgba=".15 .6 .58 1"/>
        <body name="elbow" pos="0 0 .35">
          <joint name="pitch" type="hinge" axis="0 1 0" range="-60 60" damping="2"/>
          <geom name="joint_shell" type="sphere" size=".045"/>
          <geom name="forearm" type="box" size=".14 .025 .025" pos=".14 0 0" rgba=".25 .45 .65 1"/>
          <body name="tool" pos=".28 0 0">
            <geom name="tool_shell" type="box" size=".04 .04 .035"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
