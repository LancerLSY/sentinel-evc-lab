# 文本统一以 LF 保存；签名证据按原始字节检出。
* text=auto eol=lf

*.jsonl text eol=lf
*.sig binary
*.public binary

# manifest 摘要和签名都依赖 bundle 的原始字节，禁止换行转换。
sample_run/bundle/* binary

# 这些产物是普通文本，固定 LF 便于跨平台复现。
tests/fixtures/*.jsonl text eol=lf
sample_run/scenario.json text eol=lf
sample_run/summary.json text eol=lf
sample_run/report.html text eol=lf
